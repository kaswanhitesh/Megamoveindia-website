Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# One canonical address: https://megamoveindia.com (no www)
RewriteCond %{HTTP_HOST} ^www\.megamoveindia\.com$ [NC]
RewriteRule ^ https://megamoveindia.com%{REQUEST_URI} [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old and duplicate addresses
RewriteRule ^industries/industrial/?$ /industries/industrial-plants/ [R=301,L]
RewriteRule ^industries/metals-mining/?$ /industries/metal-mining/ [R=301,L]
RewriteRule ^company-profile/?$ /company-profile.pdf [R=301,L]
# Land Transport merged into ODC Transport
RewriteRule ^services/land-transport/?$ /odc-transport/ [R=301,L]

# Sitemaps from the previous WordPress site
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|category-sitemap|wp-sitemap)\.xml$ /sitemap.xml [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Long-lived cache for hashed build assets and static media
  <FilesMatch "\.(js|css|woff2?|ttf|otf|svg|png|jpe?g|webp|avif|gif|ico|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate so new deploys show up immediately
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>
